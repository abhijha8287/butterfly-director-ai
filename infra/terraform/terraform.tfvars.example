# Copy this to terraform.tfvars and fill in the secrets.
# NEVER commit terraform.tfvars to git (it's already in .gitignore).

aws_region  = "us-east-1"
environment = "staging"

# Database
db_password = "change-me-to-a-strong-password"

# App
secret_key = "change-me-to-a-random-64-char-string"

# AI providers
dashscope_api_key = ""          # get from https://dashscope-intl.aliyuncs.com — required for LLM + Wan video + CosyVoice
gemini_api_key    = ""          # optional — get from https://aistudio.google.com/apikey

# LLM selection (qwen uses dashscope_api_key; gemini uses gemini_api_key)
llm_provider = "qwen"
qwen_model   = "qwen-plus"
gemini_model = "gemini-2.0-flash"
